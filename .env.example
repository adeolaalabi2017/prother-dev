# ==============================================================================
# Prother Environment Variables Reference
# ==============================================================================
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Core Site Configuration
# ------------------------------------------------------------------------------
# Base canonical URL for OpenGraph images, sitemaps, and RSS feeds
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 2. Convex Database & Real-Time Storage
# ------------------------------------------------------------------------------
# The cloud or local URL for your Convex backend instance
NEXT_PUBLIC_CONVEX_URL="https://your-deployment-name.convex.cloud"

# (Optional) Local Convex site URL for local dev
# NEXT_PUBLIC_CONVEX_SITE_URL="http://127.0.0.1:3211"

# ------------------------------------------------------------------------------
# 3. Authentication (NextAuth.js & Convex Adapter)
# ------------------------------------------------------------------------------
# Set to 'convex' for edge-ready session storage on Cloudflare Workers
AUTH_STORE="convex"

# Random secret string for signing JWT tokens and session cookies
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="change-this-to-a-secure-random-string"

# NextAuth base URL
NEXTAUTH_URL="http://localhost:3000"

# Set to 'false' in production to disable internal dev magic link inbox
AUTH_DEV_LINKS="true"

# (Optional) Google OAuth credentials for one-click sign-in
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# ------------------------------------------------------------------------------
# 4. Email Transport (Magic Links & Notifications)
# ------------------------------------------------------------------------------
# Resend API key for transactional emails
RESEND_API_KEY="re_your_api_key_here"

# Sender email address
EMAIL_FROM="Prother <login@prother.dev>"

# ------------------------------------------------------------------------------
# 5. Cloudflare Workers (Deployment Secrets)
# ------------------------------------------------------------------------------
# When building for Cloudflare Workers via OpenNext
# NEXT_OUTPUT="cloudflare"
# CLOUDFLARE_API_TOKEN=""
# CLOUDFLARE_ACCOUNT_ID=""
