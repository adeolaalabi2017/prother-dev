generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ── Newsletter / waitlist (PRD Appendix D, F-45) ────────────────────────
model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  source    String   @default("waitlist") // waitlist | hero | footer | exit
  confirmed Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ── Taxonomy (PRD §13 — 10 primary categories) ──────────────────────────
model Category {
  id        String @id @default(cuid())
  slug      String @unique
  name      String
  emoji     String
  sortOrder Int
  tools     Tool[]
}

// ── Tools (one table, status-driven per PRD §16 schema decisions) ───────
model Tool {
  id            String    @id @default(cuid())
  slug          String    @unique
  name          String
  tagline       String // 5–60 chars (S3)
  description   String?
  websiteUrl    String
  logoEmoji     String    @default("⬡")
  logoGradient  String    @default("from-orange-500 to-amber-700")
  pricingModel  String // free | freemium | paid | open_source
  startingPrice String?
  pricingNote   String?
  hasApi        Boolean   @default(false)
  githubUrl     String?
  docsUrl       String?
  twitterUrl    String?
  tags          String    @default("") // pipe-separated, ≤5 (controlled vocab §13)
  /** Claim owner's account email (set when a claim is verified — F-30). */
  makerEmail    String?
  track         String    @default("editor_seed") // editor_seed | community
  editorsPick   Boolean   @default(false)
  curated       Boolean   @default(false)
  claimed       Boolean   @default(false)
  makerHandle   String    @default("@prother")
  relaunch      Boolean   @default(false)
  /** F-35: number of successful re-launches + latest version label. */
  relaunchCount Int       @default(0)
  relaunchNote  String?
  /** UTC date of the ORIGINAL launch window (survives re-launches). */
  originalLaunchDate DateTime?
  /** Lifecycle per PRD §16: draft → pending_review → approved → live → removed
   *  (soft delete — history and votes survive). Admin-managed. */
  status        String    @default("live")
  /** Editorial pin rank 0–3 (0 = unpinned). Pinned rows lead today's feed. */
  pinned        Int       @default(0)
  verifiedAt    DateTime?
  categoryId    String
  category      Category  @relation(fields: [categoryId], references: [id])
  launch        Launch?
  /** Exact link back to the approved Submission (set by the editor decision
   *  route; nullable for editor-seeded tools). Written via $queryRaw — see
   *  the stale-PrismaClient note in lib/prother.ts. */
  submissionId  String?   @unique
  comments      Comment[]
  reviews       Review[]
  claims        Claim[]
  collectionItems CollectionItem[]
  relaunchEvents  RelaunchEvent[]
  createdAt     DateTime  @default(now())
}

// ── Launches (votes reference launch_id → fresh vote pools on re-launch) ─
model Launch {
  id          String   @id @default(cuid())
  tool        Tool     @relation(fields: [toolId], references: [id])
  toolId      String   @unique
  launchDate  DateTime // UTC midnight of launch day
  scheduled   Boolean  @default(false) // true = tomorrow teaser
  baseUpvotes Int      @default(0) // seeded community votes
  votes       Vote[]
  createdAt   DateTime @default(now())
}

// ── Votes (1 per anonymous visitor per launch, F-14) ────────────────────
model Vote {
  id        String   @id @default(cuid())
  launch    Launch   @relation(fields: [launchId], references: [id])
  launchId  String
  voterKey  String // anon localStorage key
  createdAt DateTime @default(now())
  @@unique([launchId, voterKey])
}

// ── Submission wizard queue (PRD §11 — Track B: community submit, F-21) ─
model Submission {
  id               String   @id @default(cuid())
  email            String // maker contact (auth-lite stand-in for landing scope)
  websiteUrl       String
  domain           String // normalized for the 1-per-domain rate limit
  name             String
  tagline          String // 5–60 chars (S3)
  description      String // 20–500 chars
  categorySlug     String
  tags             String   @default("") // pipe-separated, ≤5, controlled vocab §13
  pricingModel     String // free | freemium | paid | open_source
  startingPrice    String?
  pricingNote      String?
  hasApi           Boolean  @default(false)
  githubUrl        String?
  docsUrl          String?
  twitterUrl       String?
  logoEmoji        String   @default("⬡")
  logoGradient     String   @default("from-orange-500 to-amber-700")
  isOwner          Boolean  @default(true)
  confirmedLive    Boolean  @default(false) // ☑ "My tool is live and usable right now"
  agreedStandards  Boolean  @default(false) // ☑ "I've read the Listing Standards (S1–S6)"
  status           String   @default("pending") // pending | approved | rejected
  reviewNote       String?
  createdAt        DateTime @default(now())

  @@index([email, createdAt])
  @@index([domain])
  @@index([status, createdAt])
}

// ── Launch discussion (comments on tool listings) ────────────────────────
// Auth-lite: display-name only for the landing scope; isMaker is derived by
// the API when the author matches the tool's makerHandle. Access goes through
// $queryRaw helpers in lib/discussion.ts (stale-PrismaClient note there).
model Comment {
  id        String   @id @default(cuid())
  tool      Tool     @relation(fields: [toolId], references: [id], onDelete: Cascade)
  toolId    String
  author    String // display name, 2–24 chars
  body      String // 4–280 chars
  isMaker   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([toolId, createdAt])
}

// ── Journal (blog) — SEO workhorse layer (user-requested feature) ────────
// Long-form articles: launch playbooks, ranking explainers, ecosystem notes.
// SEO fields (seoTitle/seoDescription/keywords) feed metas, JSON-LD Article
// schema, sitemap.xml and the RSS journal feed.
model Post {
  id             String    @id @default(cuid())
  slug           String    @unique
  title          String
  excerpt        String // 80–200 chars, used in cards + meta description
  body           String // markdown
  coverEmoji     String    @default("📝")
  coverGradient  String    @default("from-orange-500 to-amber-700")
  category       String    @default("Playbooks") // editorial bucket label
  tags           String    @default("") // pipe-separated free labels
  status         String    @default("draft") // draft | published
  author         String    @default("Prother Editorial")
  readingMinutes Int       @default(4)
  views          Int       @default(0)
  seoTitle       String? // ≤60 chars — falls back to title
  seoDescription String? // ≤160 chars — falls back to excerpt
  keywords       String? // comma-separated SEO keywords
  publishedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now()) @updatedAt

  @@index([status, publishedAt])
}

// ── Site settings — KV store the Admin Console writes, the site reads ────
// Lets the editor manage frontend copy (hero, announcement, footer) without
// deploys. Absent keys fall back to in-code defaults.
model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @default(now()) @updatedAt
}

// ── Audit log — who did what in the Admin Console (PRD §16: audit trail) ─
model AuditLog {
  id        String   @id @default(cuid())
  action    String // e.g. "tool.update", "post.publish", "submission.approve"
  entity    String // tool | post | category | submission | settings | import
  entityId  String   @default("")
  meta      String   @default("") // short human-readable detail
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// ── NextAuth (F-37: email magic links + Google OAuth) ────────────────────
// Standard v4 Prisma-adapter shape; lib/auth.ts implements the adapter.
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  /** Public handle, e.g. "@dana" — derived from the email prefix at creation. */
  handle        String?   @unique
  bio           String?
  createdAt     DateTime  @default(now())
  accounts      Account[]
  sessions      Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires      DateTime

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ── Reviews (F-16) — account-gated, 3 ratings + body, maker self-block ───
// Aggregate display unlocks at ≥3 reviews (P3 policy). Accounts <48h old
// land in the soft-moderation filter (status "filtered").
model Review {
  id        String   @id @default(cuid())
  tool      Tool     @relation(fields: [toolId], references: [id], onDelete: Cascade)
  toolId    String
  userId    String
  author    String // display name at review time (e.g. "@dana")
  /** The three PRD ratings, 1–5 each: Ease / Power / Value. */
  ease      Int
  power     Int
  value     Int
  body      String // 20–2000 chars
  /** "published" | "filtered" (<48h soft-moderation). */
  status    String   @default("published")
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([toolId, userId])
  @@index([toolId, createdAt])
}

// ── Claims (F-30) — ownership verification for unclaimed listings ────────
// Method "meta_tag": maker adds <meta name="prother-claim" content=TOKEN> to
// their site head; verify fetches the site and matches. Method "email_domain"
// auto-verifies when the signed-in email domain == the tool's domain.
model Claim {
  id         String    @id @default(cuid())
  tool       Tool      @relation(fields: [toolId], references: [id], onDelete: Cascade)
  toolId     String
  userEmail  String
  userName   String
  method     String    @default("meta_tag") // meta_tag | email_domain
  token      String    @unique
  /** pending | verified | failed | disputed */
  status     String    @default("pending")
  note       String?
  createdAt  DateTime  @default(now())
  verifiedAt DateTime?

  @@index([toolId])
  @@index([userEmail])
}

// ── Collections (F-39 personal / F-40 public shareable) ──────────────────
model Collection {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String   @default("")
  isPublic    Boolean  @default(false)
  ownerEmail  String
  ownerName   String
  items       CollectionItem[]
  createdAt   DateTime @default(now())

  @@index([ownerEmail])
}

model CollectionItem {
  id           String     @id @default(cuid())
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  collectionId String
  tool         Tool       @relation(fields: [toolId], references: [id], onDelete: Cascade)
  toolId       String
  position     Int        @default(0)
  createdAt    DateTime   @default(now())

  @@unique([collectionId, toolId])
  @@index([toolId])
}

// ── Follows (F-41) — follow tools / categories / makers ──────────────────
model Follow {
  id         String   @id @default(cuid())
  userEmail  String
  /** tool | category | maker */
  targetType String
  /** tool slug, category slug, or maker handle (with @). */
  targetId   String
  targetLabel String
  createdAt  DateTime @default(now())

  @@unique([userEmail, targetType, targetId])
  @@index([userEmail])
}

// ── Re-launch history (F-35) — archived launch windows + fresh vote pool ─
// On re-launch the current Launch row is reset (new date, votes cleared) and
// the previous window is archived here so launch history survives.
model RelaunchEvent {
  id         String   @id @default(cuid())
  tool       Tool     @relation(fields: [toolId], references: [id], onDelete: Cascade)
  toolId     String
  version    String // e.g. "v2.0"
  note       String?
  /** UTC date of the archived (previous) launch window. */
  launchedAt DateTime
  totalVotes Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([toolId, createdAt])
}

// ── Comparison log (F-08) — powers "popular comparisons" ─────────────────
model Comparison {
  id        String   @id @default(cuid())
  aSlug     String
  bSlug     String
  views     Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([aSlug, bSlug])
  @@index([views])
}
