generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ── Newsletter / waitlist (PRD Appendix D, F-45) ────────────────────────
model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  source    String   @default("waitlist") // waitlist | hero | footer | exit
  confirmed Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ── Taxonomy (PRD §13 — 10 primary categories) ──────────────────────────
model Category {
  id        String @id @default(cuid())
  slug      String @unique
  name      String
  emoji     String
  sortOrder Int
  tools     Tool[]
}

// ── Tools (one table, status-driven per PRD §16 schema decisions) ───────
model Tool {
  id            String    @id @default(cuid())
  slug          String    @unique
  name          String
  tagline       String // 5–60 chars (S3)
  description   String?
  websiteUrl    String
  logoEmoji     String    @default("⬡")
  logoGradient  String    @default("from-orange-500 to-amber-700")
  pricingModel  String // free | freemium | paid | open_source
  startingPrice String?
  pricingNote   String?
  hasApi        Boolean   @default(false)
  githubUrl     String?
  docsUrl       String?
  twitterUrl    String?
  tags          String    @default("") // pipe-separated, ≤5 (controlled vocab §13)
  track         String    @default("editor_seed") // editor_seed | community
  editorsPick   Boolean   @default(false)
  curated       Boolean   @default(false)
  claimed       Boolean   @default(false)
  makerHandle   String    @default("@prother")
  relaunch      Boolean   @default(false)
  /** Lifecycle per PRD §16: draft → pending_review → approved → live → removed
   *  (soft delete — history and votes survive). Admin-managed. */
  status        String    @default("live")
  /** Editorial pin rank 0–3 (0 = unpinned). Pinned rows lead today's feed. */
  pinned        Int       @default(0)
  verifiedAt    DateTime?
  categoryId    String
  category      Category  @relation(fields: [categoryId], references: [id])
  launch        Launch?
  /** Exact link back to the approved Submission (set by the editor decision
   *  route; nullable for editor-seeded tools). Written via $queryRaw — see
   *  the stale-PrismaClient note in lib/prother.ts. */
  submissionId  String?   @unique
  comments      Comment[]
  createdAt     DateTime  @default(now())
}

// ── Launches (votes reference launch_id → fresh vote pools on re-launch) ─
model Launch {
  id          String   @id @default(cuid())
  tool        Tool     @relation(fields: [toolId], references: [id])
  toolId      String   @unique
  launchDate  DateTime // UTC midnight of launch day
  scheduled   Boolean  @default(false) // true = tomorrow teaser
  baseUpvotes Int      @default(0) // seeded community votes
  votes       Vote[]
  createdAt   DateTime @default(now())
}

// ── Votes (1 per anonymous visitor per launch, F-14) ────────────────────
model Vote {
  id        String   @id @default(cuid())
  launch    Launch   @relation(fields: [launchId], references: [id])
  launchId  String
  voterKey  String // anon localStorage key
  createdAt DateTime @default(now())
  @@unique([launchId, voterKey])
}

// ── Submission wizard queue (PRD §11 — Track B: community submit, F-21) ─
model Submission {
  id               String   @id @default(cuid())
  email            String // maker contact (auth-lite stand-in for landing scope)
  websiteUrl       String
  domain           String // normalized for the 1-per-domain rate limit
  name             String
  tagline          String // 5–60 chars (S3)
  description      String // 20–500 chars
  categorySlug     String
  tags             String   @default("") // pipe-separated, ≤5, controlled vocab §13
  pricingModel     String // free | freemium | paid | open_source
  startingPrice    String?
  pricingNote      String?
  hasApi           Boolean  @default(false)
  githubUrl        String?
  docsUrl          String?
  twitterUrl       String?
  logoEmoji        String   @default("⬡")
  logoGradient     String   @default("from-orange-500 to-amber-700")
  isOwner          Boolean  @default(true)
  confirmedLive    Boolean  @default(false) // ☑ "My tool is live and usable right now"
  agreedStandards  Boolean  @default(false) // ☑ "I've read the Listing Standards (S1–S6)"
  status           String   @default("pending") // pending | approved | rejected
  reviewNote       String?
  createdAt        DateTime @default(now())

  @@index([email, createdAt])
  @@index([domain])
  @@index([status, createdAt])
}

// ── Launch discussion (comments on tool listings) ────────────────────────
// Auth-lite: display-name only for the landing scope; isMaker is derived by
// the API when the author matches the tool's makerHandle. Access goes through
// $queryRaw helpers in lib/discussion.ts (stale-PrismaClient note there).
model Comment {
  id        String   @id @default(cuid())
  tool      Tool     @relation(fields: [toolId], references: [id], onDelete: Cascade)
  toolId    String
  author    String // display name, 2–24 chars
  body      String // 4–280 chars
  isMaker   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([toolId, createdAt])
}

// ── Journal (blog) — SEO workhorse layer (user-requested feature) ────────
// Long-form articles: launch playbooks, ranking explainers, ecosystem notes.
// SEO fields (seoTitle/seoDescription/keywords) feed metas, JSON-LD Article
// schema, sitemap.xml and the RSS journal feed.
model Post {
  id             String    @id @default(cuid())
  slug           String    @unique
  title          String
  excerpt        String // 80–200 chars, used in cards + meta description
  body           String // markdown
  coverEmoji     String    @default("📝")
  coverGradient  String    @default("from-orange-500 to-amber-700")
  category       String    @default("Playbooks") // editorial bucket label
  tags           String    @default("") // pipe-separated free labels
  status         String    @default("draft") // draft | published
  author         String    @default("Prother Editorial")
  readingMinutes Int       @default(4)
  views          Int       @default(0)
  seoTitle       String? // ≤60 chars — falls back to title
  seoDescription String? // ≤160 chars — falls back to excerpt
  keywords       String? // comma-separated SEO keywords
  publishedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now()) @updatedAt

  @@index([status, publishedAt])
}

// ── Site settings — KV store the Admin Console writes, the site reads ────
// Lets the editor manage frontend copy (hero, announcement, footer) without
// deploys. Absent keys fall back to in-code defaults.
model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @default(now()) @updatedAt
}

// ── Audit log — who did what in the Admin Console (PRD §16: audit trail) ─
model AuditLog {
  id        String   @id @default(cuid())
  action    String // e.g. "tool.update", "post.publish", "submission.approve"
  entity    String // tool | post | category | submission | settings | import
  entityId  String   @default("")
  meta      String   @default("") // short human-readable detail
  createdAt DateTime @default(now())

  @@index([createdAt])
}
