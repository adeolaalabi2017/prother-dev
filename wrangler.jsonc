{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "prother",
  // OpenNext → Cloudflare Workers (Workers with static assets is the modern
  // successor to Cloudflare Pages for Next.js — @cloudflare/next-on-pages is
  // deprecated). `opennextjs-cloudflare build` fills .open-next/worker.js.
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-12-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "AUTH_STORE": "convex",
    "AUTH_DEV_LINKS": "false",
    "NEXT_PUBLIC_SITE_URL": "https://prother.dev"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "prother",
      "database_id": "ab47ba10-6e7e-4d73-a1ef-dfee0a6e4147"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "c5e5112657dd4d6594d0c25b1279fe65"
    }
  ]
  // R2 pending: enable R2 in dashboard (billing required), then add:
  // "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "prother-media" }]
  // KV durable ISR cache: wire kvIncrementalCache in open-next.config.ts later.
}
