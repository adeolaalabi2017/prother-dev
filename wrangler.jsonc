{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "prother",
  // OpenNext → Cloudflare Workers (Workers with static assets is the modern
  // successor to Cloudflare Pages for Next.js — @cloudflare/next-on-pages is
  // deprecated). `opennextjs-cloudflare build` fills .open-next/worker.js.
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-12-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
  // Optional (later): KV/R2 bindings for durable ISR caching.
  // No database binding is needed — all data lives in Convex (see DEPLOY.md).
  // "kv_namespaces": [{ "binding": "NEXT_INC_CACHE_KV", "id": "<id>" }]
}
